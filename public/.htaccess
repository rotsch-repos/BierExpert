# Apache-Einstellungen für die ausgelieferte Seite (Hostpoint fährt Apache).
#
# Diese Datei liegt in public/ und landet damit im Build. Das ist Absicht:
# Das Deploy räumt im Zielverzeichnis auf, was nicht zum Build gehört — läge
# die Datei nur auf dem Server, wäre sie nach dem ersten Deploy weg.

<IfModule mod_headers.c>
  # Die Dateinamen unter assets/ tragen einen Inhalts-Hash. Ändert sich der
  # Inhalt, ändert sich der Name — sie dürfen deshalb beliebig lange liegen
  # bleiben.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html trägt keinen Hash und verweist auf die gehashten Dateien.
  # Würde sie zwischengespeichert, bekämen wiederkehrende Besucher nach einem
  # Deploy weiter die alte Seite mit Verweisen auf gelöschte Dateien.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Bilder ändern sich selten, tragen aber keinen Hash — ein Tag ist der
  # Kompromiss zwischen Frische und Last.
  <FilesMatch "\.(svg|png|jpe?g|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Bewusst KEINE Umleitung auf HTTPS an dieser Stelle.
#
# Sie gehört zur Einrichtung beim Anbieter, nicht in die Anwendung: Nur der
# Anbieter weiß, ob für die Domain bereits ein Zertifikat vorliegt. Eine
# Umleitung aus dieser Datei macht die Seite unerreichbar, solange das
# Zertifikat noch aussteht — genau das war hier der Fall.
#
# Sobald das Zertifikat ausgestellt ist: im Hostpoint-Panel bei der Website
# die HTTPS-Erzwingung einschalten. Dann greift sie zum richtigen Zeitpunkt
# und kann nicht in eine Sackgasse laufen.
#
# Bis dahin: Die Seite läuft über http. Die Schaltfläche "Aus Zwischenablage"
# bleibt dabei ohne Funktion, weil navigator.clipboard einen sicheren Kontext
# verlangt; sie sagt das auch. Einfügen mit Strg+V funktioniert weiterhin,
# das braucht keinen sicheren Kontext.
#
# Der Vollständigkeit halber, falls die Umleitung doch hierher soll: Der
# Prüfpfad der Zertifizierungsstelle muss ausgenommen bleiben
# (RewriteRule ^\.well-known/ - [L]), sonst kann sie den Nachweis über
# einfaches http nicht führen.

# Verzeichnisinhalte nicht auflisten.
Options -Indexes
