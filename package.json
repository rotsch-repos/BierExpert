{
  "name": "bierexpert",
  "version": "0.1.0",
  "private": true,
  "description": "Bierflasche fotografieren, Entstehungsgeschichte erfahren — im Klosterstil",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
