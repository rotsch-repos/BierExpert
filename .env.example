# Vorlage für die Werte, die der Server braucht.
#
# Im Betrieb steht nichts davon in einer Datei im Repository: Die Werte
# liegen in GitHub unter Settings → Secrets and variables → Actions, und
# deploy/konfiguration.sh schreibt daraus bei jedem Deploy die Datei
# ~/.bierexpert/konfiguration.php auf dem Server — ausserhalb des
# Wurzelverzeichnisses, wo weder ein Besucher noch das nächste Deploy
# herankommt.
#
# Diese Datei ist die Übersicht darüber, was zu hinterlegen ist, und die
# Vorlage für einen lokalen Lauf (cp .env.example .env; .env steht in der
# .gitignore).

# ---------------------------------------------------------------- Datenbank
# Als Variable, ausser dem Passwort — das gehört unter Secrets.
#
# Der Host ist nur innerhalb des Hostpoint-Netzes auflösbar. Von aussen —
# auch vom GitHub-Runner — ist er nicht erreichbar. Alles, was die Datenbank
# anfasst, läuft deshalb über SSH auf dem Server; das PHP-Backend steht ja
# selbst darin.
#
# Fehlt DB_PASSWORT, läuft die Anwendung ohne Zwischenspeicher: jeder Scan
# geht dann ans Modell. Langsamer, aber vollständig.
DB_HOST=atozadec.mysql.db.internal
DB_NAME=atozadec_bierexpert
DB_USER=atozadec_expert
DB_PASSWORT=

# --------------------------------------------------------- Sprachmodell
# Ollama auf eigener Hardware, erreichbar über den Cloudflare-Tunnel.
#
# LLM_ENDPUNKT ist die Wurzel des Dienstes, OHNE "/api" am Ende — das hängt
# der Client selbst an. Als Secret, denn die Adresse zeigt auf den Rechner
# zu Hause.
LLM_ENDPUNKT=

# Nur nötig, wenn vor Ollama ein nginx steht, der einen Schlüssel verlangt.
# Ollama selbst kennt keine Anmeldung. Als Secret.
LLM_SCHLUESSEL=

# Als Variable. Das grosse Modell zerlegt das Etikett und gibt die
# Bildbereiche an; das kleine liest nur ab, wer es gebraut hat, und findet
# bei einem Treffer die bekannten Elemente im Foto wieder. Beide müssen
# Bilder verstehen.
#
# qwen3-vl:30b und nicht :32b, obwohl die Zahl kleiner aussieht: Der 30b ist
# ein MoE-Modell und rechnet je Token nur einen Bruchteil seiner Gewichte.
# Auf derselben Karte und derselben Etikettaufgabe gemessen 11 s gegen 135 s,
# bei besserer Trefferlage. Und Cloudflare bricht nach 100 Sekunden ohne
# Antwort ab — mit dem 32b liefe der erste Aufruf genau dort hinein.
LLM_MODELL=qwen3-vl:30b
LLM_MODELL_SCHNELL=qwen3-vl:8b

# Die Anthropic-Brücke: Steht LLM_ANBIETER auf "anthropic", beantwortet die
# Anthropic-API die Modellfragen statt des eigenen Ollama — die Übergangs-
# lösung, solange der Weg zum eigenen Modell durch fremde Zeitgrenzen führt.
# Der Schlüssel kommt aus der Console (console.anthropic.com). Als Secret.
LLM_ANBIETER=ollama

# Feiner: Wer beantwortet WELCHE Stufe. Beide fallen auf LLM_ANBIETER
# zurück, wenn sie leer bleiben.
#
# Die empfohlene Einstellung für den Eigenbetrieb ist die Mischung:
#
#   LLM_ANBIETER_SCHNELL=ollama
#   LLM_ANBIETER_TIEF=anthropic
#
# Der Grund ist eine Frage der Häufigkeit. Das Ablesen ("welches Bier ist
# das?") läuft bei JEDEM Foto, auch beim tausendsten Tannenzäpfle, und
# gehört deshalb dorthin, wo es nichts kostet — 1,5-5 s beim eigenen 8b.
# Das Zerlegen eines Etiketts läuft genau EINMAL je Bier; danach steht es
# in der Datenbank und wird von dort geliefert. Diese eine Auswertung
# entscheidet aber, was jeder spätere Leser zu sehen bekommt, und sie soll
# deshalb stimmen.
#
# Die Rechnung wächst damit nicht mit den Scans, sondern mit der Zahl der
# noch unbekannten Biere — und die wird mit jedem Fund kleiner.
LLM_ANBIETER_SCHNELL=
LLM_ANBIETER_TIEF=
ANTHROPIC_SCHLUESSEL=
ANTHROPIC_MODELL=claude-opus-5
ANTHROPIC_MODELL_SCHNELL=claude-opus-5
