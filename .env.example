# Vorlage für die Konfiguration. Kopieren nach .env und ausfüllen.
#
#   cp .env.example .env
#
# .env selbst gehört NICHT ins Repository — es steht in der .gitignore.
# In GitHub gehören dieselben Werte unter Settings → Secrets and variables:
# Zugangsdaten als Secret, alles andere als Variable.

# ---------------------------------------------------------------- Datenbank
# Der Host ist nur innerhalb des Hostpoint-Netzes auflösbar. Von außen — auch
# vom GitHub-Runner — ist er nicht erreichbar. Alles, was die Datenbank
# anfasst, läuft deshalb über SSH auf dem Server.
DB_HOST=atozadec.mysql.db.internal
DB_NAME=atozadec_bierexpert
DB_USER=atozadec_expert
DB_PASSWORT=

# --------------------------------------------------------- Sprachmodell
# Der Endpunkt des lokalen Dienstes. Noch offen, siehe README:
# zu klären ist, welcher Dienst läuft, ob er Bilder versteht und ob er
# eine JSON-Struktur nach Schema erzwingen kann.
LLM_ENDPUNKT=
LLM_MODELL=
LLM_SCHLUESSEL=
